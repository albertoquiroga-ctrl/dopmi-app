{"body":{"x":16.0,"y":95.0,"width":345.0,"height":662.0},"textBlocks":[{"text":"¿Activamos tu modo Rescatista?","x":34.0,"y":123.0,"width":289.0,"height":56.0},{"text":"Publica casos de mascotas con necesidad de un hogar.","x":34.0,"y":187.0,"width":289.0,"height":40.0},{"text":"Tu perfil de Adoptante se queda intacto.","x":46.0,"y":241.0,"width":232.1674346923828,"height":16.0},{"text":"Cambias de navegación","x":95.0,"y":292.0,"width":163.03602600097656,"height":18.0},{"text":"Ves Inicio, Casos y Publicar pensados para quien rescata.","x":95.0,"y":312.0,"width":235.0,"height":34.0},{"text":"Armas el perfil del compañerito","x":95.0,"y":380.0,"width":214.64678955078125,"height":18.0},{"text":"Nombre, fotos e historia para que alguien se enamore de verdad.","x":95.0,"y":400.0,"width":235.0,"height":34.0},{"text":"Publicas cuando estés listo","x":95.0,"y":468.0,"width":186.0537109375,"height":18.0},{"text":"Te guiamos paso a paso y puedes pausar cuando quieras.","x":95.0,"y":488.0,"width":235.0,"height":34.0},{"text":"Vuelves a Adoptante en un toque","x":95.0,"y":556.0,"width":226.15371704101562,"height":18.0},{"text":"Tu perfil de Adoptante no se borra: regresas cuando lo necesites.","x":95.0,"y":576.0,"width":235.0,"height":34.0},{"text":"Sí, cambiar a Rescatista","x":96.44202423095703,"y":657.5,"width":184.11595153808594,"height":19.0},{"text":"Ahora no","x":157.81593322753906,"y":710.5,"width":61.368133544921875,"height":17.0},{"text":"×","x":324.44091796875,"y":108.0,"width":14.5556640625,"height":22.0}],"cancel":{"x":34.0,"y":699.0,"width":309.0,"height":40.0}}