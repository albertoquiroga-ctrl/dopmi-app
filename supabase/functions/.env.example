# Test mode only. Configure in Supabase secrets; never in Flutter or React.
STRIPE_SECRET_KEY_H4_TEST=rk_test_REPLACE_LOCALLY
# Existing installations may keep STRIPE_SECRET_KEY as a fallback.
STRIPE_SECRET_KEY=sk_test_REPLACE_LOCALLY
STRIPE_WEBHOOK_SECRET_H4_TEST=whsec_REPLACE_LOCALLY
# Existing installations may keep STRIPE_WEBHOOK_SECRET as a fallback.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_LOCALLY
DOPMI_WORKER_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET

# Optional Android advertising measurement. Keep closed until the linked
# dataset, Android consent and store disclosures are verified.
DOPMI_META_ADS_ENABLED=false
DOPMI_META_ADS_WORKER_SECRET=
DOPMI_META_ADS_DATASET_ID=
DOPMI_META_ADS_ACCESS_TOKEN=
